# Coyote's Dune Delivery — Netlify Functions / local env template
# Copy names into Netlify Site settings → Environment variables.
# NEVER commit real secret values. Placeholders only.

# Public site origin (CORS). Live:
#   https://coyote-dune-delivery.netlify.app
SITE_ORIGIN=https://coyote-dune-delivery.netlify.app

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin auth (login-admin JWT)
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Stripe (PaymentIntents + webhook). Use test keys until go-live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Checkr background checks
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
# Optional package slug (has a code default)
# CHECKR_PACKAGE=

# Optional Firebase Admin SDK JSON (push notifications)
# FIREBASE_ADMIN_SDK_JSON=

# Optional / Express leftover only (backend/) — prefer Netlify Functions
# JWT_EXPIRES_IN=24h
# UPLOAD_DIR=./uploads
# PORT=3000
# NODE_ENV=development

# Stripe Dashboard → Webhooks → endpoint URL (live site):
#   https://coyote-dune-delivery.netlify.app/api/payment-webhook
# Frontend loads STRIPE_PUBLISHABLE_KEY via GET /api/public-config (never expose secret keys).
